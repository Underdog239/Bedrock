# Optional server-side provider defaults. Copy these into your private .env file.
# If AI_PROVIDER is empty, OpenRouter is preferred when OPENROUTER_API_KEY is set;
# otherwise the server uses GEMINI_API_KEY when available.
# You can also set a temporary provider key in AI Mind > AI provider.
# Runtime keys are kept in server memory only and cleared when the app server restarts.
# Never prefix secrets with VITE_: that would expose them in the browser bundle.
AI_PROVIDER=""
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/auto"

# Optional alternative provider.
GEMINI_API_KEY=""

# Public URL of the app when hosted, if required by your deployment platform.
APP_URL=""
